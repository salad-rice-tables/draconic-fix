+++ b/src/server/scripts/Custom/draconic_solo_dungeon.cpp
@@ -0,0 +1,231 @@
+/*
+ * Draconic-WoW: solo dungeons, Earthen Wall Totem and leaving the LFG state.
+ *
+ *  1. Solo dungeons: a player who is the only person in a 5-player dungeon instance (the LFG follower group of one counts as alone)
+ *     meets creatures adapted to a lone hero: they keep a part of their health, and the hero carries the Manastorm boon auras
+ *     (-15% damage taken, +20% stamina, 6% leech) for as long as he is alone. As soon as a second player joins the instance everything
+ *     is restored, so groups play exactly as on retail.
+ *  2. Earthen Wall Totem (shaman): the totem shields the owner's party members around it (retail does this with a script that
+ *     this core did not have).
+ *  3. Leaving a dungeon while in an LFG group of one drops the group, so the Group Finder is usable again (Leave Queue).
+ */
+
+#include "Creature.h"
+#include "CreatureAI.h"
+#include "DungeonFinding/LFGMgr.h"
+#include "Group.h"
+#include "Map.h"
+#include "MapManager.h"
+#include "Player.h"
+#include "ScriptedCreature.h"
+#include "ScriptMgr.h"
+#include "SpellAuras.h"
+#include "SpellMgr.h"
+#include <mutex>
+#include <unordered_set>
+#include <vector>
+
+namespace
+{
+    constexpr float SOLO_HP_NORMAL = 0.40f;
+    constexpr float SOLO_HP_ELITE = 0.50f;
+    constexpr uint32 SOLO_BOONS[] = { 1402101, 1402104, 1402105 };   // -15% damage taken, +20% stamina, 6% leech (Manastorm boons)
+    constexpr uint32 SOLO_TICK_MS = 3000;
+
+    std::mutex SoloMutex;
+    std::unordered_set<ObjectGuid> SoloScaled;
+
+    void SoloSetBoons(Player* player, bool on)
+    {
+        for (uint32 spellId : SOLO_BOONS)
+        {
+            if (on)
+            {
+                if (!player->HasAura(spellId) && sSpellMgr->GetSpellInfo(spellId, DIFFICULTY_NONE))
+                    player->CastSpell(player, spellId, true);
+            }
+            else if (player->HasAura(spellId))
+                player->RemoveAurasDueToSpell(spellId);
+        }
+    }
+
+    void SoloScaleCreature(Creature* creature, bool apply)
+    {
+        if (!creature || creature->IsPet() || creature->IsSummon() || creature->IsTotem() || creature->IsVehicle())
+            return;
+
+        std::lock_guard<std::mutex> lock(SoloMutex);
+        bool const scaled = SoloScaled.count(creature->GetGUID()) != 0;
+        if (apply == scaled)
+            return;
+
+        float pct = 1.0f;
+        if (apply)
+            pct = (creature->IsElite() || creature->isWorldBoss()) ? SOLO_HP_ELITE : SOLO_HP_NORMAL;
+
+        creature->SetStatPctModifier(UNIT_MOD_HEALTH, BASE_PCT, pct);
+        creature->UpdateMaxHealth();
+        if (!creature->IsInCombat() && creature->IsAlive())
+            creature->SetFullHealth();
+
+        if (apply)
+            SoloScaled.insert(creature->GetGUID());
+        else
+            SoloScaled.erase(creature->GetGUID());
+    }
+
+    // A harmful aura without end that a creature put on a player stays forever when the creature died or is gone (retail clears it
+    // with encounter scripts this core does not have): drop it.
+    void ClearOrphanedPermanentDebuffs(Player* player)
+    {
+        std::vector<uint32> remove;
+        for (auto const& [spellId, app] : player->GetAppliedAuras())
+        {
+            Aura const* aura = app->GetBase();
+            if (!aura || !aura->IsPermanent() || app->IsPositive() || !aura->GetCasterGUID().IsCreatureOrVehicle())
+                continue;
+            Unit* caster = aura->GetCaster();
+            if (!caster || !caster->IsAlive() || !caster->IsInWorld())
+                remove.push_back(spellId);
+        }
+        for (uint32 spellId : remove)
+            player->RemoveAurasDueToSpell(spellId);
+    }
+
+    void SoloHandleMap(Map* map)
+    {
+        if (!map->IsNonRaidDungeon())
+            return;
+
+        uint32 const players = map->GetPlayersCountExceptGMs();
+        bool const alone = players == 1;
+
+        for (MapReference const& ref : map->GetPlayers())
+        {
+            Player* player = ref.GetSource();
+            if (player && !player->IsGameMaster())
+            {
+                SoloSetBoons(player, alone);
+                ClearOrphanedPermanentDebuffs(player);
+            }
+        }
+
+        if (players == 0)
+            return;
+
+        Player* first = nullptr;
+        for (MapReference const& ref : map->GetPlayers())
+            if (ref.GetSource() && !ref.GetSource()->IsGameMaster()) { first = ref.GetSource(); break; }
+        if (!first)
+            return;
+
+        for (auto const& [spawnId, creature] : map->GetCreatureBySpawnIdStore())
+        {
+            if (!creature || !creature->IsInWorld() || creature->IsFriendlyTo(first))
+                continue;
+            SoloScaleCreature(creature, alone);
+        }
+    }
+}
+
+class draconic_solo_dungeon_world : public WorldScript
+{
+public:
+    draconic_solo_dungeon_world() : WorldScript("draconic_solo_dungeon_world") { }
+
+    void OnUpdate(uint32 diff) override
+    {
+        _timer += diff;
+        if (_timer < SOLO_TICK_MS)
+            return;
+        _timer = 0;
+
+        sMapMgr->DoForAllMaps([](Map* map) { SoloHandleMap(map); });
+
+        std::lock_guard<std::mutex> lock(SoloMutex);
+        if (SoloScaled.size() > 100000)
+            SoloScaled.clear();
+    }
+
+private:
+    uint32 _timer = 0;
+};
+
+class draconic_solo_dungeon_player : public PlayerScript
+{
+public:
+    draconic_solo_dungeon_player() : PlayerScript("draconic_solo_dungeon_player") { }
+
+    void OnMapChanged(Player* player) override
+    {
+        if (!player)
+            return;
+
+        Map* map = player->GetMap();
+        if (!map || map->IsDungeon())
+            return;
+
+        // out of the dungeon: the solo boons go away, and an LFG group of one is dropped so the Group Finder is free again
+        SoloSetBoons(player, false);
+        if (Group* group = player->GetGroup())
+        {
+            if (group->isLFGGroup() && group->GetMembersCount() <= 1)
+            {
+                lfg::LfgState state = sLFGMgr->GetState(player->GetGUID());
+                if (state == lfg::LFG_STATE_DUNGEON || state == lfg::LFG_STATE_FINISHED_DUNGEON)
+                    player->RemoveFromGroup(GROUP_REMOVEMETHOD_LEAVE);
+            }
+        }
+    }
+};
+
+struct npc_sha_earthen_wall_totem : public ScriptedAI
+{
+    npc_sha_earthen_wall_totem(Creature* creature) : ScriptedAI(creature) { }
+
+    static constexpr uint32 SPELL_SHIELD = 17;      // Power Word: Shield as the absorb carrier
+    static constexpr float RANGE = 10.0f;
+
+    void Reset() override
+    {
+        _timer = 1000;
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_timer > diff)
+        {
+            _timer -= diff;
+            return;
+        }
+        _timer = 1000;
+
+        Unit* owner = me->GetOwner();
+        if (!owner)
+            return;
+
+        std::list<Player*> players;
+        me->GetPlayerListInGrid(players, RANGE);
+        for (Player* player : players)
+        {
+            if (!player->IsAlive() || player->HasAura(SPELL_SHIELD))
+                continue;
+            if (player != owner && !(owner->IsPlayer() && owner->ToPlayer()->IsInSameGroupWith(player)))
+                continue;
+
+            CastSpellExtraArgs args(TRIGGERED_FULL_MASK);
+            args.AddSpellMod(SPELLVALUE_BASE_POINT0, int32(std::max<uint32>(40, player->GetMaxHealth() / 8)));
+            me->CastSpell(player, SPELL_SHIELD, args);
+        }
+    }
+
+private:
+    uint32 _timer = 1000;
+};
