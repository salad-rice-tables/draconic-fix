+    // .house buy [plot]: buy the plot of the cornerstone you stand next to (within 7 yards), or the given plot index (the first house is free)
+    static bool HandleBuyCommand(ChatHandler* handler, Optional<uint8> plotIndex)
+    {
+        constexpr float CornerstoneRange = 7.0f;
+        constexpr uint32 CornerstoneEntry = 457142;
+
+        Player* player = handler->GetSession()->GetPlayer();
+        uint8 plot = 0;
+        if (plotIndex)
+            plot = *plotIndex;
+        else
+        {
+            std::list<GameObject*> cornerstones;
+            player->GetGameObjectListWithEntryInGrid(cornerstones, CornerstoneEntry, CornerstoneRange);
+            GameObject* nearest = nullptr;
+            for (GameObject* go : cornerstones)
+                if (go->GetHousingCornerstonePlotIndex() >= 0 && (!nearest || player->GetDistance(go) < player->GetDistance(nearest)))
+                    nearest = go;
+
+            if (!nearest)
+            {
+                handler->PSendSysMessage("Stand next to a plot cornerstone (within %.0f yards), or use .house buy <plot>.", CornerstoneRange);
+                handler->SetSentErrorMessage(true);
+                return false;
+            }
+
+            plot = uint8(nearest->GetHousingCornerstonePlotIndex());
+        }
+
+        handler->PSendSysMessage("Buying plot %u...", uint32(plot));
+        player->GetSession()->BuyHouseOnPlot(plot);
+        if (player->GetHousing())
+            handler->PSendSysMessage("Done: you own plot %u now. Walk to your door to enter.", uint32(plot));
+        else
+            handler->PSendSysMessage("The purchase was refused (the reason is in the server log, search for HandleNeighborhoodBuyHouse).");
+        return true;
+    }
+
