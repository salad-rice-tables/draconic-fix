+
+void SpellMgr::LoadHeroSpellCosts()
+{
+    uint32 oldMSTime = getMSTime();
+    _heroSpellCosts.clear();
+
+    QueryResult result = WorldDatabase.Query("SELECT spell_id, cost FROM hero_spell_cost");
+    if (result)
+    {
+        do
+        {
+            Field* fields = result->Fetch();
+            _heroSpellCosts[fields[0].GetUInt32()] = fields[1].GetInt32();
+        } while (result->NextRow());
+    }
+
+    TC_LOG_INFO("server.loading", ">> Loaded {} hero spell costs in {} ms", _heroSpellCosts.size(), GetMSTimeDiffToNow(oldMSTime));
+}
+
+int32 SpellMgr::GetHeroSpellCost(uint32 spellId) const
+{
+    auto itr = _heroSpellCosts.find(spellId);
+    return itr != _heroSpellCosts.end() ? itr->second : -1;
+}
