+            return true;
+        }
+
+        std::string where = "unknown location";
+        if (Neighborhood const* neighborhood = sNeighborhoodMgr.GetNeighborhood(housing->GetNeighborhoodGuid()))
+        {
+            for (NeighborhoodPlotData const* plot : sHousingMgr.GetPlotsForMap(neighborhood->GetNeighborhoodMapID()))
+                if (plot->PlotIndex == int32(housing->GetPlotIndex()))
+                {
+                    where = Trinity::StringFormat("{} at {:.0f}, {:.0f}, {:.0f} (map {})", neighborhood->GetName(),
+                        plot->HousePosition[0], plot->HousePosition[1], plot->HousePosition[2], neighborhood->GetNeighborhoodMapID());
+                    break;
+                }
+        }
+
+        handler->PSendSysMessage("House: yes, plot %u in %s, level %u, favor %u.",
+            uint32(housing->GetPlotIndex()), where.c_str(), uint32(housing->GetLevel()), uint32(housing->GetFavor()));
+        return true;
+    }
+
